// Prisma schema — Avero Pro
// Self-service SaaS for TPE/PME: online presence + simple CRM + quotes/invoices.
// Multi-tenant: every business entity is scoped to an Organization (= one TPE/PME).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Core / Auth / Multi-tenant
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // owner of the business account
  MEMBER // team member, limited settings access
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sector    String? // free-text business activity, e.g. "Boulangerie", "Plomberie"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing letterhead — shown on generated quote/invoice PDFs.
  address      String? @db.Text
  siret        String?
  vatNumber    String?
  phone        String?
  contactEmail String?
  bankName     String?
  iban         String?
  bic          String?
  paymentTerms String? @db.Text
  vatEnabled   Boolean @default(true)
  vatRate      Decimal @default(20) @db.Decimal(5, 2)

  // Mandatory legal mentions on invoices / quotes (French Code de commerce).
  legalForm         String? // e.g. "SARL", "SAS", "EI / auto-entrepreneur"
  shareCapital      String? // capital social, free text (e.g. "10 000 €")
  rcsCity           String? // ville du greffe (RCS)
  latePenaltyText   String? @db.Text // taux des pénalités de retard
  recoveryIndemnity Decimal @default(40) @db.Decimal(10, 2) // indemnité forfaitaire frais de recouvrement
  discountTerms     String? @db.Text // conditions d'escompte
  quoteValidityDays Int     @default(30) // durée de validité par défaut d'un devis

  users           User[]
  clients         Client[]
  sites           Site[]
  googleListing   GoogleListing?
  reviews         Review[]
  invoices        Invoice[]
  quotes          Quote[]
  activityLogs    ActivityLog[]
  creditNotes     CreditNote[]
  payments        Payment[]
  catalogItems    CatalogItem[]
  numberSequences NumberSequence[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Clients — the TPE/PME's own customers (CRM)
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?      @db.Text
  status      ClientStatus @default(PROSPECT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  quotes       Quote[]
  creditNotes  CreditNote[]
  activityLogs ActivityLog[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Présence en ligne : mon site, ma fiche Google, mes avis
// ---------------------------------------------------------------------------

enum SiteStatus {
  ONLINE
  MAINTENANCE
  OFFLINE
  NOT_LAUNCHED
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String // e.g. "Site vitrine", "Boutique en ligne"
  url        String?
  status     SiteStatus @default(NOT_LAUNCHED)
  launchedAt DateTime?
  notes      String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model GoogleListing {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  businessName  String?
  mapsUrl       String?
  category      String?
  rating        Decimal?  @db.Decimal(2, 1)
  reviewCount   Int       @default(0)
  lastCheckedAt DateTime?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewSource {
  GOOGLE
  FACEBOOK
  OTHER
}

model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  source      ReviewSource @default(GOOGLE)
  authorName  String?
  rating      Int // 1 to 5
  comment     String?      @db.Text
  response    String?      @db.Text
  respondedAt DateTime?
  receivedAt  DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Invoices (facturation de mes clients)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PAID
  PARTIAL // partiellement réglée (voir Payment[])
  UNPAID
  OVERDUE
  CREDITED // soldée par un ou plusieurs avoirs
  CANCELLED // legacy — ne plus proposer, émettre un avoir à la place
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId        String?      @unique
  quote          Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  number    String // numérotation légale continue, ex. "FAC-2026-0001"
  title     String?
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(UNPAID)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?       @db.Text

  lineItems   InvoiceLineItem[]
  payments    Payment[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Quotes (devis) — sent to a client for approval before becoming an Invoice
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  number      String // numérotation continue, ex. "DEV-2026-0001"
  title       String
  description String?     @db.Text
  amount      Decimal     @db.Decimal(10, 2)
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  validUntil  DateTime?
  notes       String?     @db.Text

  invoice   Invoice?
  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Activity log (client history timeline)
// ---------------------------------------------------------------------------

enum ActivityType {
  CLIENT_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  CREDIT_NOTE_ISSUED
  REVIEW_RECEIVED
  NOTE
  OTHER
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Numérotation légale — une séquence continue par organisation, type et année
// ---------------------------------------------------------------------------

enum DocumentKind {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

model NumberSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind      DocumentKind
  year      Int
  lastValue Int          @default(0)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, kind, year])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Avoirs (notes de crédit) — rattachés à une facture émise
// ---------------------------------------------------------------------------

model CreditNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  number    String // ex. "AV-2026-0001"
  reason    String?  @db.Text
  amount    Decimal  @db.Decimal(10, 2) // montant crédité, positif
  issueDate DateTime @default(now())

  lineItems CreditNoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([clientId])
}

model CreditNoteLineItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description  String
  quantity     Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal    @db.Decimal(10, 2)
  position     Int        @default(0)

  @@index([creditNoteId])
}

// ---------------------------------------------------------------------------
// Encaissements — un ou plusieurs paiements par facture (règlements partiels)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  TRANSFER
  CARD
  CASH
  CHECK
  OTHER
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(TRANSFER)
  receivedAt DateTime      @default(now())
  note       String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Catalogue produits & prestations — lignes réutilisables dans devis/factures
// ---------------------------------------------------------------------------

model CatalogItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text
  unitPrice   Decimal @db.Decimal(10, 2)
  unit        String? // "h", "jour", "forfait", "u"…
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}
