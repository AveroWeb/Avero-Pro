// Prisma schema — Avero Pro
// Self-service SaaS for TPE/PME: online presence + simple CRM + quotes/invoices.
// Multi-tenant: every business entity is scoped to an Organization (= one TPE/PME).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Core / Auth / Multi-tenant
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // owner of the business account
  MEMBER // team member, limited settings access
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sector    String? // free-text business activity, e.g. "Boulangerie", "Plomberie"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing letterhead — shown on generated quote/invoice PDFs.
  address      String? @db.Text
  siret        String?
  vatNumber    String?
  phone        String?
  contactEmail String?
  bankName     String?
  iban         String?
  bic          String?
  paymentTerms String? @db.Text
  vatEnabled   Boolean @default(true)
  vatRate      Decimal @default(20) @db.Decimal(5, 2)

  users         User[]
  clients       Client[]
  sites         Site[]
  googleListing GoogleListing?
  reviews       Review[]
  invoices      Invoice[]
  quotes        Quote[]
  activityLogs  ActivityLog[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Clients — the TPE/PME's own customers (CRM)
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?      @db.Text
  status      ClientStatus @default(PROSPECT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  quotes       Quote[]
  activityLogs ActivityLog[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Présence en ligne : mon site, ma fiche Google, mes avis
// ---------------------------------------------------------------------------

enum SiteStatus {
  ONLINE
  MAINTENANCE
  OFFLINE
  NOT_LAUNCHED
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String // e.g. "Site vitrine", "Boutique en ligne"
  url        String?
  status     SiteStatus @default(NOT_LAUNCHED)
  launchedAt DateTime?
  notes      String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model GoogleListing {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  businessName  String?
  mapsUrl       String?
  category      String?
  rating        Decimal?  @db.Decimal(2, 1)
  reviewCount   Int       @default(0)
  lastCheckedAt DateTime?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewSource {
  GOOGLE
  FACEBOOK
  OTHER
}

model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  source      ReviewSource @default(GOOGLE)
  authorName  String?
  rating      Int // 1 to 5
  comment     String?      @db.Text
  response    String?      @db.Text
  respondedAt DateTime?
  receivedAt  DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Invoices (facturation de mes clients)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId        String?      @unique
  quote          Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  title     String?
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(UNPAID)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?       @db.Text

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Quotes (devis) — sent to a client for approval before becoming an Invoice
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  description String?     @db.Text
  amount      Decimal     @db.Decimal(10, 2)
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  validUntil  DateTime?
  notes       String?     @db.Text

  invoice   Invoice?
  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Activity log (client history timeline)
// ---------------------------------------------------------------------------

enum ActivityType {
  CLIENT_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  NOTE
  OTHER
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([createdAt])
}
